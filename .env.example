# OnixGuard — variables de entorno de desarrollo.
# Copia este archivo a `.env` y rellena los valores reales. `.env` está gitignoreado.
# NUNCA commitees secretos reales.

# ─────────────── PostgreSQL (EXTERNO al compose) ───────────────
# Postgres corre en el VPS/host, NO en Docker. Desde un contenedor, el host NO es "localhost":
#   - Mac/Windows:  usa host.docker.internal
#   - VPS (Linux):  usa la IP del host o host-gateway (ya configurado en el servicio migrate)
# Base de PRUEBAS (para make migrate / make test-db):
DATABASE_URL=postgresql://devtools:CHANGE_ME@host.docker.internal:5432/onixguard_test
# Base de PRODUCCIÓN (no usar en dev):
# DATABASE_URL=postgresql://devtools:CHANGE_ME@host.docker.internal:5432/onixguard

# ─────────────── NATS ───────────────
# Dentro del compose los servicios usan nats://nats:4222 (nombre de servicio).
# Esta var es para clientes externos (p. ej. onix-hook en tu PC apuntando al VPS).
NATS_URL=nats://localhost:4222
# En producción: nats://onix.devtoolsdk.com:4222 con TLS + token de máquina.
# NATS_TOKEN=CHANGE_ME

# ─────────────── Gateway / panel (se usan desde Fase 3) ───────────────
# JWT_SECRET=CHANGE_ME
# PANEL_USER=jefe
# PANEL_PASSWORD_HASH=CHANGE_ME_argon2
